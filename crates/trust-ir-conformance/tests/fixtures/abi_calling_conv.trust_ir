}

rust_coldcc fn @foreign_rust_coldcc(functy.0) {
}

rustcc fn @caller(functy.0) {
bb0:
    %0 = const ptr fndef<func.0>
    call_indirect %0(functy.0)() cc=c_unwindcc
    ret
}
