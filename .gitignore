# Rust
target/
# `target` may be a symlink to `target.noindex`, which keeps Spotlight out on macOS.
# `target/` above matches only a directory, so these two lines cover the link and
# its destination. The Trust superproject's `targo trust release validate` refuses
# local info/exclude rules in a submodule, so the rule has to be committed.
/target
/target.noindex
/target-tippy/
**/*.rs.bk

# Lean / Lake build cache (never track; symlinking it across worktrees corrupts the repo)
.lake/
**/.lake

# Python tooling caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Editors
*~
\#*\#
.#*

# OS junk
.DS_Store
# macOS partial-transfer / AppleDouble artifacts (a 0-byte pair slipped into
# tests/fixtures once; keep them out for good).
.!*
._*

# Credentials and secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
*.secret
.secrets/

# Benchmark / eval run outputs (the harnesses write results under these)
benchmarks/**/results/
benchmarks/**/logs/
evals/**/results/
evals/**/logs/

# Claude Code agent worktrees (transient)
.claude/worktrees/
.claude/

# Publish tool work area (export tree, report, staging clone)
publish/.out/

# Generated report archive payloads are retained through report-artifacts.json.
# The sealed standing fixture is already tracked and remains exact.
/reports/**/*.bin
/reports/**/*.gz
/reports/**/*.xz
/reports/**/*.zst
/reports/**/*.zip
/reports/**/*.tar
/reports/**/*.tgz
/reports/**/*.bz2
/reports/**/*.7z
/reports/**/*.olean
/reports/**/*.ilean
